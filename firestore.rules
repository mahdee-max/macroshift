rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents: isolated to owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Sub-collections under user (e.g. logs, weight)
      match /daily_logs/{date} {
        allow read, write: if isOwner(userId);
      }
      
      match /weight_history/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-level daily_logs collection with userId field verification
    match /daily_logs/{logId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Top-level weight_history collection with userId field verification
    match /weight_history/{entryId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
